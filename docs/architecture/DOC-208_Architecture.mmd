%% Target architecture under the full application mandate; not a deployment claim.
flowchart TB
  APP[Flutter - all non-privileged roles] --> CF[Cloudflare ingress]
  CONSOLE[Protected Django console - administrators and moderators] --> CF
  CF --> NGINX[Host Nginx on AWS staging Swarm manager]
  NGINX --> GW[Gateway]
  subgraph TARGET[Approved 12-service target - 9 built, 3 design only]
    GW --> ID[Identity - Notifications and consent module]
    GW --> CR[Creators]
    GW --> CT[Content - R2 and FFmpeg; image extension designed]
    GW --> EN[Engagement - comments designed]
    EN --> PT[Points - non-cash only]
    GW --> MO[Moderation]
    GW --> AU[Audit]
    GW --> BZ[Business]
    GW --> FN[Finance - single monetary ledger and providers]
    GW --> EV[Events - inventory and tickets]
    GW --> AD[Advertising - campaigns and measurement]
  end
  TARGET --> DB[(PostgreSQL - isolated service schemas and roles)]
  TARGET --> MQ[RabbitMQ - outbox/inbox and per-consumer queues]
  CT --> R2[Private R2 - hardened media workers]
  PT -. immutable eligible-points weight snapshot .-> FN
  EV -. operational requests .-> FN
  AD -. billable facts .-> FN
  FN -. verified outcomes .-> EV
  MQ --> ND[Identity notify-dispatch - isolated role]
  ND --> PROVIDERS[Push and transactional email interfaces]
  DB --> BK[Encrypted backups - policy and restore gate open]
