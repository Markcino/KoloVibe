# Minimal upstream FFmpeg for the KoloVibe media worker, packaged as an ordinary apk named `ffmpeg` at its true
# version so the image scanner and the SBOM see it and report against it. The source is pinned by SHA-512 (the value
# Alpine's own APKBUILD records for this tarball) and abuild refuses a mismatch. Everything the pipeline does not use
# is compiled out: no network protocols (so no RTSP), no devices, no libavdevice, no other codecs, muxers, filters or
# optional libraries. What stays is what services/content/service/media_encoding.py runs: MP4/MOV in, H.264/HEVC/AAC
# (and MP3/ALAC/PCM) decoded, scaled with swscale, H.264 (libx264) and AAC out in MP4, a JPEG poster, the `volume` filter and WAV
# output for copyright muting and fingerprinting, `file` and `pipe` protocols. The `color` and `anullsrc` source filters exist only for the repository's own end-to-end media test.
pkgname=ffmpeg
pkgver=9.0.2
pkgrel=0
pkgdesc="Minimal upstream FFmpeg for the KoloVibe media worker (MP4 in; H.264, AAC and JPEG out; file and pipe only)"
url="https://ffmpeg.org/"
arch="x86_64 aarch64"
license="GPL-2.0-or-later"
depends="x264-libs"
makedepends="nasm pkgconf x264-dev zlib-dev"
options="!check"
source="https://ffmpeg.org/releases/ffmpeg-$pkgver.tar.xz"
builddir="$srcdir/ffmpeg-$pkgver"

build() {
	cd "$builddir"
	./configure --prefix=/usr \
	  --disable-everything --disable-autodetect --disable-hwaccels --disable-vdpau --disable-network --disable-doc --disable-debug \
	  --disable-ffplay --disable-avdevice --disable-shared --enable-static --enable-pic \
	  --enable-gpl --enable-libx264 --enable-zlib --enable-ffmpeg --enable-ffprobe \
	  --enable-protocol=file --enable-protocol=pipe \
	  --enable-demuxer=mov --enable-muxer=mp4 --enable-muxer=image2 --enable-muxer=wav \
	  --enable-decoder=h264 --enable-decoder=hevc --enable-decoder=aac --enable-decoder=mp3float \
	  --enable-decoder=alac --enable-decoder=pcm_s16le --enable-decoder=pcm_s16be --enable-decoder=pcm_s24le \
	  --enable-encoder=libx264 --enable-encoder=aac --enable-encoder=mjpeg --enable-encoder=pcm_s16le \
	  --enable-parser=h264 --enable-parser=hevc --enable-parser=aac --enable-parser=mpegaudio \
	  --enable-bsf=null --enable-bsf=aac_adtstoasc \
	  --enable-filter=scale --enable-filter=format --enable-filter=aformat --enable-filter=aresample \
	  --enable-filter=null --enable-filter=anull --enable-filter=buffer --enable-filter=buffersink \
	  --enable-filter=abuffer --enable-filter=abuffersink --enable-filter=color --enable-filter=anullsrc --enable-filter=volume \
	  --extra-cflags='-O2 -fstack-protector-strong -fPIE' --extra-ldflags='-Wl,-z,relro -Wl,-z,now' \
	  --extra-ldexeflags='-pie'
	make -j"$(nproc)" ffmpeg ffprobe
}

package() {
	cd "$builddir"
	make install-progs DESTDIR="$pkgdir"
	strip "$pkgdir"/usr/bin/ffmpeg "$pkgdir"/usr/bin/ffprobe
}

sha512sums="
7756f8434371b9bc1d01cf578bf49014e058b0869c3c1df05030f5f4035f1def64b2e7dba3cf340da4dc8dd9239dd5f894530c9e45793ac27876807079aa546a  ffmpeg-9.0.2.tar.xz
"
