# Development/CI validation image; production runtime is gated on deployment ADRs.
FROM python:3.12.12-slim-bookworm
ARG SERVICE
WORKDIR /app

# A predictable, immutable dependency set, verified against package hashes.
COPY requirements-dev.txt /tmp/requirements-dev.txt
RUN python -m pip install --no-cache-dir --require-hashes -r /tmp/requirements-dev.txt \
    && python -m pip check \
    && groupadd --system --gid 10001 kolovibe \
    && useradd --system --uid 10001 --gid 10001 --no-create-home kolovibe

COPY --chown=10001:10001 services/${SERVICE}/ /app/
USER 10001:10001
EXPOSE 8000

# Local-mode settings deliberately refuse production or staging use.
# Docker smoke checks supply KOLOVIBE_ENV and DJANGO_SECRET_KEY at runtime.
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000", "--noreload"]
