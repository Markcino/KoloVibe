# Shared service image with two build targets.
#   release (default, last stage): PostgreSQL-only. SQLite is removed, so the image
#       that CI scans, verifies and publishes carries no sqlite-libs. Staging
#       already refuses SQLite, so every supported release profile is unaffected.
#   local:  SQLite fallback retained for local development and unit-test runs.
#       It is not scanned, verified or published; never deploy it.
# A bare `docker build` produces the release target, so the unsafe image is opt-in.
#
# The same `release` target also builds the separate media-worker image (the only one with FFmpeg):
#   docker build --target release --build-arg PYTHON_BASE=<alpine3.24 python digest> --build-arg WITH_FFMPEG=1 \
#     --build-arg FFMPEG_SOURCE=ffmpeg-minimal .
# The default build has no FFmpeg and the unchanged Alpine 3.23 base. The two images are scanned, verified and
# published separately by CI; the eight API services and the queue consumers use only the shared one.
ARG PYTHON_BASE=python:3.12.16-alpine3.23@sha256:20d13dc88e7bc1adf6e18cdddeb4cd53a7e0fdc3825bfe05f00c7563d4cdf102
# The media image's FFmpeg is a minimal upstream build (ffmpeg-minimal), not Alpine's full package: a full FFmpeg
# drags in ~115 packages (cjson, alsa-lib, glib, libssh, ...) with unfixed High and Critical findings, and no packaged
# release passes the image scan. The default build gets an empty directory instead and contains no FFmpeg.
ARG FFMPEG_BUILD_BASE=alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
ARG FFMPEG_SOURCE=ffmpeg-empty

# Local/CI and restricted staging image; production remains gated.
FROM ${PYTHON_BASE} AS local
WORKDIR /app
ENV PYTHONPATH=/app/services

# Pull Alpine security fixes published after the pinned base image was built
# (zlib, krb5-libs). Never replace this with a scanner exception.
RUN apk upgrade --no-cache

# A predictable, immutable dependency set, verified against package hashes.
COPY requirements-dev.txt /tmp/requirements-dev.txt
RUN python -m pip install --no-cache-dir --require-hashes -r /tmp/requirements-dev.txt \
    && python -m pip check \
    && addgroup -S -g 10001 kolovibe \
    && adduser -S -D -H -u 10001 -G kolovibe kolovibe

COPY --chown=10001:10001 services/ /app/services/
RUN chown 10001:10001 /app
USER 10001:10001
EXPOSE 8000

# Staging requires external secret files, verified TLS and explicit capabilities.
ENTRYPOINT ["python", "-m", "staging_runtime.launch"]
CMD []

# ---- Minimal FFmpeg for the media worker (built only when FFMPEG_SOURCE=ffmpeg-minimal) -------------------------
# Upstream FFmpeg 9.0.2 (the newest release; 9.0 fixes CVE-2026-70628, -70632 and -96611 that Alpine 3.24's 8.1.3
# carries), source pinned by SHA-512 (the value Alpine's own APKBUILD records for this tarball). Everything not named
# below is compiled out: no network protocols (so no RTSP), no devices, no libavdevice, no other codecs, muxers or
# filters, no optional libraries. Only what media_encoding.py runs: MP4/MOV in, H.264/HEVC/AAC (and MP3/ALAC/PCM)
# decoded, scaled with swscale, H.264 (libx264) + AAC out in MP4, and a JPEG poster. `color` and `anullsrc` are
# source filters used only by the repository's own end-to-end media test.
FROM ${FFMPEG_BUILD_BASE} AS ffmpeg-minimal
ARG FFMPEG_VERSION=9.0.2
ARG FFMPEG_SHA512=7756f8434371b9bc1d01cf578bf49014e058b0869c3c1df05030f5f4035f1def64b2e7dba3cf340da4dc8dd9239dd5f894530c9e45793ac27876807079aa546a
RUN set -eux; \
    apk add --no-cache build-base nasm pkgconf curl ca-certificates xz x264-dev zlib-dev; \
    cd /tmp; \
    curl -fsSL --proto '=https' --tlsv1.2 -o ffmpeg.tar.xz "https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz"; \
    echo "${FFMPEG_SHA512}  ffmpeg.tar.xz" | sha512sum -c -; \
    tar -xJf ffmpeg.tar.xz; \
    cd "ffmpeg-${FFMPEG_VERSION}"; \
    ./configure --prefix=/usr \
      --disable-everything --disable-autodetect --disable-network --disable-doc --disable-debug \
      --disable-ffplay --disable-avdevice --disable-shared --enable-static --enable-pic \
      --enable-gpl --enable-libx264 --enable-zlib --enable-ffmpeg --enable-ffprobe \
      --enable-protocol=file --enable-protocol=pipe \
      --enable-demuxer=mov --enable-muxer=mp4 --enable-muxer=image2 \
      --enable-decoder=h264 --enable-decoder=hevc --enable-decoder=aac --enable-decoder=mp3float \
      --enable-decoder=alac --enable-decoder=pcm_s16le --enable-decoder=pcm_s16be --enable-decoder=pcm_s24le \
      --enable-encoder=libx264 --enable-encoder=aac --enable-encoder=mjpeg \
      --enable-parser=h264 --enable-parser=hevc --enable-parser=aac --enable-parser=mpegaudio \
      --enable-bsf=null --enable-bsf=aac_adtstoasc \
      --enable-filter=scale --enable-filter=format --enable-filter=aformat --enable-filter=aresample \
      --enable-filter=null --enable-filter=anull --enable-filter=buffer --enable-filter=buffersink \
      --enable-filter=abuffer --enable-filter=abuffersink --enable-filter=color --enable-filter=anullsrc \
      --extra-cflags='-O2 -fstack-protector-strong -fPIE' --extra-ldflags='-Wl,-z,relro -Wl,-z,now' \
      --extra-ldexeflags='-pie'; \
    make -j"$(nproc)" ffmpeg ffprobe; \
    make install-progs DESTDIR=/out; \
    strip /out/usr/bin/ffmpeg /out/usr/bin/ffprobe; \
    /out/usr/bin/ffmpeg -hide_banner -version | head -1

# The default (shared-image) build copies this empty directory: no FFmpeg, no encoder libraries.
FROM local AS ffmpeg-empty
USER root
RUN mkdir /out

# `COPY --from` cannot expand a variable, so the selected source is named by a stage of its own.
FROM ${FFMPEG_SOURCE} AS ffmpeg-source

# PostgreSQL-only release image. The base image's Python links the SQLite C library
# (sqlite-libs), which carries High CVEs with no fixed Alpine package. Nothing in the
# supported release profiles uses it: staging and the PostgreSQL profile use psycopg.
FROM local AS release
USER root
# apk tracks Python's runtime libraries through one virtual package that also depends
# on sqlite-libs. Re-pin every other runtime library under a new virtual package
# first, so removing sqlite-libs cannot cascade into libraries Python still needs.
RUN set -eux; \
    apk info -R .python-rundeps | awk 'NF && $0 !~ /depends on:$/ && $0 !~ /sqlite/' > /tmp/python-rundeps; \
    test -s /tmp/python-rundeps; \
    apk add --no-cache --virtual .kolovibe-python-rundeps $(cat /tmp/python-rundeps); \
    apk del .python-rundeps sqlite-libs; \
    rm -f /tmp/python-rundeps; \
    pydir="$(python -c 'import os; print(os.path.dirname(os.__file__))')"; \
    rm -rf "$pydir"/sqlite3 "$pydir"/lib-dynload/_sqlite3*; \
    if apk info -e sqlite-libs | grep -q .; then echo "sqlite-libs is still installed" >&2; exit 1; fi; \
    if apk list -I | grep -qi sqlite; then echo "An SQLite package is still installed" >&2; exit 1; fi; \
    if python -c 'import sqlite3' 2>/dev/null; then echo "sqlite3 is still importable" >&2; exit 1; fi; \
    python -c 'import ssl, ctypes, zlib, bz2, lzma, readline, curses, pyexpat, uuid, decimal, hashlib'; \
    python -c 'import django, psycopg, cryptography.fernet, celery, kombu, gunicorn, yaml, pyotp'; \
    python -m pip check

# FFmpeg exists only in the media-worker image (WITH_FFMPEG=1, FFMPEG_SOURCE=ffmpeg-minimal on the Alpine 3.24 base). It is installed after the SQLite removal and re-checked, so its dependency closure
# cannot bring SQLite back. Only the media worker (Content, `--role media-worker`) ever executes it, with a fixed
# minimal PATH and input limits. A scanner finding in these packages fails that image's gate; never excepted.
ARG WITH_FFMPEG=0
COPY --from=ffmpeg-source /out/ /
RUN set -eux; \
    if [ "$WITH_FFMPEG" = "1" ]; then \
      apk add --no-cache x264-libs; \
      ffmpeg -version >/dev/null; ffprobe -version >/dev/null; \
      if ffmpeg -hide_banner -protocols 2>&1 | grep -Eiq 'rtsp|rtp|http|tcp|udp|tls|ftp|srt|rtmp'; then \
        echo "A network protocol is compiled into FFmpeg" >&2; exit 1; fi; \
    elif command -v ffmpeg >/dev/null 2>&1 || command -v ffprobe >/dev/null 2>&1; then \
      echo "FFmpeg must not be in the shared image" >&2; exit 1; fi; \
    if apk list -I | grep -qi sqlite; then echo "An SQLite package is installed" >&2; exit 1; fi; \
    if python -c 'import sqlite3' 2>/dev/null; then echo "sqlite3 is importable" >&2; exit 1; fi
USER 10001:10001
