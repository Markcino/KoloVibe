# Production-only configuration inventory. Root .env is LOCAL ONLY.
# Do not copy this template over the local .env or load local credentials on a VM.
# Production runtime is currently rejected; this inventory does not authorize it.
# Production Actions environment/provisioning is not implemented or verified.
# Store credentials in protected GitHub Environment secrets, then provision
# external owner-only runtime secret files. Never commit values or bake into images.
KOLOVIBE_ENV=production
DJANGO_DEBUG=0

# Runtime inputs: supply separately to each of the eight API service containers.
# Use distinct Django/DB/TLS/caller/probe credentials for every service.
# Secret files: Swarm UID/GID 10001, mode 0400; paths only, never raw credentials.
KOLOVIBE_SERVICE_NAME=
KOLOVIBE_ALLOWED_HOSTS=
DJANGO_SECRET_KEY_FILE=
KOLOVIBE_DB_NAME=
KOLOVIBE_DB_USER=
KOLOVIBE_DB_HOST=
KOLOVIBE_DB_PORT=5432
KOLOVIBE_DB_PASSWORD_FILE=
KOLOVIBE_DB_SSLROOTCERT=
KOLOVIBE_INTERNAL_CA_FILE=
KOLOVIBE_TLS_CERT_FILE=
KOLOVIBE_TLS_KEY_FILE=
KOLOVIBE_CALLER_KEYS_FILE=
KOLOVIBE_PROBE_TOKEN_FILE=
# Gateway peer signing and identity audit delivery require DIFFERENT keys.
KOLOVIBE_OUTBOUND_KEY_FILE=
KOLOVIBE_TRUSTED_PEERS_FILE=

# Identity SMTP: authenticated, certificate-verified STARTTLS.
KOLOVIBE_SMTP_HOST=
KOLOVIBE_SMTP_PORT=587
KOLOVIBE_FROM_EMAIL=
KOLOVIBE_SMTP_USER_FILE=
KOLOVIBE_SMTP_PASSWORD_FILE=
# Optional reviewed private CA; unset uses system trust, never disables TLS checks.
KOLOVIBE_SMTP_CA_FILE=
# Separate Fernet encryption key, not a Django/signing secret.
KOLOVIBE_MFA_ENCRYPTION_KEY_FILE=
KOLOVIBE_ACCOUNT_APPROVAL_FILE=
# Offline owner enrollment only; do not pass authenticator secrets/codes in arguments.
KOLOVIBE_ENROLLMENT_SECRET_FILE=
KOLOVIBE_ENROLLMENT_CODE_FILE=

# Protected Environment secret inventory: values intentionally blank.
# These identity names match existing offline validation inputs, currently wired
# ONLY to staging-security-review. A production job/environment needs approval.
KOLOVIBE_IDENTITY_DJANGO_KEY=
KOLOVIBE_IDENTITY_DB_PASSWORD=
KOLOVIBE_IDENTITY_DB_CA=
KOLOVIBE_IDENTITY_TLS_CERT=
KOLOVIBE_IDENTITY_TLS_KEY=
KOLOVIBE_INTERNAL_CA=
KOLOVIBE_IDENTITY_CALLER_KEYS=
KOLOVIBE_IDENTITY_PROBE_TOKEN=
KOLOVIBE_SMTP_USER=
KOLOVIBE_SMTP_PASSWORD=
KOLOVIBE_MFA_ENCRYPTION_KEY=
KOLOVIBE_IDENTITY_AUDIT_SIGNING_KEY=

# Non-secret identity configuration: reviewed HTTPS origins and approval references.
KOLOVIBE_IDENTITY_HOSTS=
KOLOVIBE_IDENTITY_DB_USER=
KOLOVIBE_IDENTITY_AUDIT_PEERS=
KOLOVIBE_IDENTITY_APPROVALS=
# Audit peers JSON: exactly "audit" mapped to the approved canonical HTTPS origin.
# Approval references: identity, smtp, credentials, transport, mfa, audit.

# Shared image/broker references and reviewed capacity: no tags or invented budgets.
KOLOVIBE_IMAGE=
RABBITMQ_DHI_IMAGE=
API_MEMORY_LIMIT=
API_MEMORY_RESERVATION=
RABBITMQ_MEMORY_LIMIT=

# Existing external secret object inventory (names, not environment variables):
# <service>_django, _db, _tls_cert, _tls_key, _callers, _probe for gateway, identity,
# content, creators, engagement, points, moderation and audit;
# gateway_outbound, trusted_peers, internal_ca, db_ca;
# identity_smtp_user, identity_smtp_password, identity_mfa_encryption,
# identity_audit_signing, identity_audit_peers, identity_approvals;
# kolovibe_rmq_ca, kolovibe_rmq_cert, kolovibe_rmq_key, kolovibe_rmq_definitions.
# RabbitMQ definitions contain scoped user credentials; keep the whole file private.
# Producer/worker credentials and activation require separate approved provisioning.
# GHCR publication uses Actions-provided secrets.GITHUB_TOKEN; no PAT in this file.
# Current deployment YAML and security jobs are staging candidates, not production.
# See infra/swarm/README.md and docs/security/staging-verification.md.
# Test mail stays inside fixtures. No provisioning/deployment/activation is implied.
