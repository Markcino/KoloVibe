<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Owner decision SIM-02: Universal Links for shared videos. The host's
	     /.well-known/apple-app-site-association (served by the Gateway) claims only /open/videos/*. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:$(KOLOVIBE_APP_LINK_HOST)</string>
	</array>
</dict>
</plist>
